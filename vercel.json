{
  "framework": null,
  "installCommand": "echo Skipping install for static deployment",
  "buildCommand": "echo No build step required",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/service",
      "destination": "/public/index.html"
    },
    {
      "source": "/service/",
      "destination": "/public/index.html"
    },
    {
      "source": "/service/:path*",
      "destination": "/public/:path*"
    }
  ]
}