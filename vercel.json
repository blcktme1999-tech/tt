{
  "framework": null,
  "installCommand": "npm install --omit=optional",
  "buildCommand": "echo No build step required",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/service",
      "destination": "/service.html"
    },
    {
      "source": "/service/",
      "destination": "/service.html"
    },
    {
      "source": "/service/:path*",
      "destination": "/public/:path*"
    }
  ]
}